# 复制此文件为 .env，填入你的 API Key
# cp .env.example .env

# 智谱 GLM（默认）
GLM_API_KEY=your-zhipu-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.6

# 切换其他国产模型示例：
# DeepSeek:  GLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# 通义千问:   GLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
