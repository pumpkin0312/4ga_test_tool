# 复制此文件为 .env，填入你的 API Key
# cp .env.example .env

# DeepSeek（默认）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 切换其他国产模型示例：
# 智谱 GLM: DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/   LLM_MODEL=glm-4-plus
# 通义千问: DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
